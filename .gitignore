.DS_Store
node_modules/
.vercel
.clasprc.json
dashboard-web/node_modules

# .claude/ contains agent state + ad-hoc operator notes (incl. tokens.md
# where the operator pastes secrets for short-lived workflows like
# OAuth re-auth). NEVER commit — local-only.
.claude/

# Secrets — never commit. The .env file at the project root is the
# canonical store for Script Properties exported from Apps Script
# (Shopify / Meta / Google Ads tokens + per-store domains + spreadsheet
# IDs). See docs/PROPS-MAP.md (planned, v2.0 milestone) for the
# operator-facing inventory.
.env
.env.local
.env.*.local
*.env
!.env.example

# graphify-out/ holds output from the local /graphify skill (knowledge-graph
# artifacts, transient per-run). Re-generated on demand; not source-of-truth.
graphify-out/

# .superpowers/ holds local brainstorm + visual-companion artifacts
# (mockups, state). Local-only; regenerated per session.
.superpowers/
