# Google Sheets Service Account credentials.
# Create a service account in Google Cloud Console, share the spreadsheet with the
# service account email, and paste credentials here. See README.md for full setup.

GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=1f5tbc-8eMG60Go1ubTldWALc_kwnpaXD_33IsPDWrAk

# === Sentry (optional, error reporting) ===
# Without these, Sentry is a no-op. Get the DSN from sentry.io project settings.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# === WhatsApp Cloud API (Phase 05.7.4) ===
# Phone Number ID is the numeric ID from Meta API Setup (NOT the phone itself).
# Access Token must be a System User token (never expires); a 24h temporary
# token will silently break the cron one day after deploy. See User Manual
# section 30.4 for the System User generation walkthrough.
WHATSAPP_PHONE_NUMBER_ID=1091010644104167
WHATSAPP_ACCESS_TOKEN=EAA...

# === TikTok Marketing API (Phase 05.7.5) ===
# Only uzoshop runs TikTok ads currently. After App approval at
# https://business-api.tiktok.com/portal/apps, complete the OAuth handshake
# via /api/oauth/tiktok/callback (see User Manual section "TikTok integration"
# once Phase B ships) to obtain a long-lived access_token + advertiser_id.
# Until both are set, all TikTok fetcher calls throw a clear error — the
# cronDaily writer treats this as "store has no TikTok spend" and writes 0.
UZOSHOP_TIKTOK_ADVERTISER_ID=
UZOSHOP_TIKTOK_ACCESS_TOKEN=
